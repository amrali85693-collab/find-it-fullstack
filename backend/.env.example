# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=*

# Database
DATABASE_URL=postgresql://finduser:findpass@localhost:5432/find_it
# PGSSL=require   # uncomment for managed Postgres providers that need SSL (Render, Railway, RDS, Supabase, etc.)

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Uploads
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads
